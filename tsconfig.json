{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@print-delivery/ui": ["src/ui"],
      "@print-delivery/theme/*": ["src/theme/styles/*"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*", "app/**/*", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
